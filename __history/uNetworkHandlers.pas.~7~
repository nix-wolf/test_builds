unit uNetworkHandlers;

interface

uses
  uNetworkDispatcher,
  uNetworkTypes;

type
  TuNetworkHandler = class
    procedure Setup(Dispatcher: TuNetworkDispatcher);
  end;

implementation

{ TuMultiRoleHandler }

{*
    Dispatcher.Register(pfFLAG, PROTO,
    [nrNone, nrClient, nrServer, nrHub],
    [
      procedure(const P: TuPacket) begin ClientChatLogic(P); end,
      procedure(const P: TuPacket) begin ServerChatLogic(P); end
    ]
  );
*}

///////////////////////////////////////////////////////////////////////////////
//// Setup Function: Main definition linking everything together
///////////////////////////////////////////////////////////////////////////////

procedure TuNetworkHandlers.Setup(Dispatcher: TuNetworkDispatcher);
begin

  Dispatcher.Register(pfCHAT, npTCP,
    [nrClient, nrServer],
    [
      procedure(const P: TuPacket) begin ClientChatLogic(P); end,
      procedure(const P: TuPacket) begin ServerChatLogic(P); end
    ]
  );

  Dispatcher.Register(pfVEWLF, npUDP,
    [nrClient, nrHub],
    [
      procedure(const P: TuPacket) begin ClientReceiveHubBeacon(P); end,
      procedure(const P: TuPacket) begin HubHandleIncomingSearch(P); end
    ]
  );
end;

{*
pfVEWLF: Hub Check; udp
pfHTB: Heart Beat; udp
pfCHAT: Chat Message; tcp
pfSES: Session Data; tcp
pfJOIN: Join Request; tcp
pfUPD: Update Request; tcp
pfCLS: Close Signal; tcp, udp
pfKIL: Kill Signal; tcp, udp
pfSHFT: Hub Shift: tcp, udp
*}

///////////////////////////////////////////////////////////////////////////////
//// Handler Implementations::
///////////////////////////////////////////////////////////////////////////////

end.



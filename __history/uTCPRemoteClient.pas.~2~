unit uTCPRemoteClient;

interface

uses
  System.Net.Socket,
  System.Classes,
  System.SysUtils,
  uTCPServer,
  uReadThread;

  type
    TuTCPRemoteClient = class
      private
        FOwner: TuTCPServer;
        FSocket: TSocket;
        FReadThread: TuReadThread;
        FIP: String;
      public
        constructor Create(aOwner: TObject; aSocket: TSocket);
        destructor Destroy; override;

        procedure Send(const aMsg: String);
        procedure Line(const aMsg: String);
        procedure Disconnect;

        property IP: String read FIP;
    end;

implementation

{ TuTCPRemoteClient }

///////////////////////////////////////////////////////////////////////////////
//// Construction/Initalization
///////////////////////////////////////////////////////////////////////////////

constructor TuTCPRemoteClient.Create(aOwner: TObject; aSocket: TSocket);
begin
  FOwner := aOwner;
  FSocket := aSocket;

  //not sure about this
  try
    FIP := FSocket.Endpoint.Address.Address;
  except
    FIP := '0.0.0.0';
  end;

  FReadThread := TuReadThread.Create(FSocket, Send, nil);
  FReadThread.Start;
end;

///////////////////////////////////////////////////////////////////////////////
//// Other
///////////////////////////////////////////////////////////////////////////////

procedure TuTCPRemoteClient.Send(const aMsg: String);
var
  aBytes: TBytes
begin
  if TSocketState.Connected in FSocket.State then begin
    aBytes := TEncoding.UTF8.GetBytes(aMsg + #10);
    FSocket.Send(aBytes, 0, Length(aBytes));
  end; {IF}
end;

procedure TuTCPRemoteClient.Line(const aMsg: String);
begin
  if Assigned(FOwner.OnMessage) then
    FOwner.OnMessage(Self, aMsg);
end;


///////////////////////////////////////////////////////////////////////////////
//// Deconstruction
///////////////////////////////////////////////////////////////////////////////

procedure TuTCPRemoteClient.Disconnect;
begin
  if Assigned(FOwner.OnDisconnected) then
    FOwner.OnDisconnected(Self);
end;

destructor TuTCPRemoteClient.Destroy;
begin
  if Assigned(FSocket) then FSocket.Close;
  inherited;
end;

end.

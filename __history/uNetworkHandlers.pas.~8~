unit uNetworkHandlers;

interface

uses
  uNetworkDispatcher,
  uNetworkTypes;

type
  TuNetworkHandler = class
    procedure Setup(Dispatcher: TuNetworkDispatcher);
  end;

implementation

{ TuMultiRoleHandler }
ii
{*
   Dispatcher.Register(pfFLAG, PROTO,
      [nrNone, nrClient, nrServer, nrHub],
      [
         procedure(const P: TuPacket) begin nrNoneFLAGHandler(P); end,
         procedure(const P: TuPacket) begin nrClientFLAGHandler(P); end,
         procedure(const P: TuPacket) begin nrServerFLAGHandler(P); end,
         procedure(const P: TuPacket) begin nrHubFLAGHandler(P); end
      ]
   );


pfVEWLF : Hub Check      ; udp      :: A Flat UDP Broadcast check to find the hub
pfHTB   : Heart Beat     ; udp      :: A Check-in message, for hub to track dead connections
pfCHAT  : Chat Message   ; tcp      :: Is a Chat Message, displayed to UI
pfSES   : Session Data   ; tcp      :: Is the Lobby Session data for a game server
pfJOIN  : Join Request   ; tcp      :: Specifcally for Session JOIN
pfUPD   : Update Request ; tcp      :: To send Updates FOR the rendered frame
pfCLS   : Close Signal   ; tcp, udp :: Client to Server notification closed
pfKIL   : Kill Signal    ; tcp, udp :: Server to Client to drop connection
pfSHFT  : Hub Shift      ; tcp, udp :: For Shifting WHOisHUB when Hub Entity exits

*}

///////////////////////////////////////////////////////////////////////////////
//// Setup Function: Main definition linking everything together
///////////////////////////////////////////////////////////////////////////////

procedure TuNetworkHandlers.Setup(Dispatcher: TuNetworkDispatcher);
begin

   Dispatcher.Register(pfVEWLF, npUDP,
      [nrNone, nrHub],
      [
         procedure(const P: TuPacket) begin NoneVEWLFHandler(P); end,
         procedure(const P: TuPacket) begin HubVEWLFHandler(P); end,
      ]
   );

   Dispatcher.Register(pfHTB, npUDP,
      [nrNone, nrClient, nrServer, nrHub],
      [
         procedure(const P: TuPacket) begin NoneHTBHandler(P); end,
         procedure(const P: TuPacket) begin ClientHTBHandler(P); end,
         procedure(const P: TuPacket) begin ServerHTBHandler(P); end,
         procedure(const P: TuPacket) begin HubHTBHandler(P);  end
      ]
   );

   Dispatcher.Register(pfCHAT, npUDP,
      [nrNone, nrClient, nrServer, nrHub],
      [
         procedure(const P: TuPacket) begin NoneCHATHandler(P); end,
         procedure(const P: TuPacket) begin ClientCHATHandler(P); end,
         procedure(const P: TuPacket) begin ServerCHATHandler(P); end,
         procedure(const P: TuPacket) begin HubCHATHandler(P);  end
      ]
   );

   Dispatcher.Register(pfSES, npUDP,
      [nrNone, nrClient, nrServer, nrHub],
      [
         procedure(const P: TuPacket) begin NoneSESHandler(P); end,
         procedure(const P: TuPacket) begin ClientSESHandler(P); end,
         procedure(const P: TuPacket) begin ServerSESHandler(P); end,
         procedure(const P: TuPacket) begin HubSESHandler(P);  end
      ]
   );

   Dispatcher.Register(pfJOIN,
      [npTCP],
      [nrClient, nrServer],
      [
         procedure(const P: TuPacket) begin ClientJOINHandler(P); end,
         procedure(const P: TuPacket) begin ServerJOINHandler(P); end
      ]
   );

   Dispatcher.Register(pfUPD,
      [npUDP],
      [nrClient, nrServer],
      [
         procedure(const P: TuPacket) begin ClientUPDHandler(P); end,
         procedure(const P: TuPacket) begin ServerUPDHandler(P); end
      ]
   );


   Dispatcher.Register(pfCLS,
      [npUDP, npTCP],
      [nrNone, nrClient, nrServer, nrHub],
      [
         procedure(const P: TuPacket) begin NoneUPDHandler(P); end,
         procedure(const P: TuPacket) begin ClientUPDHandler(P); end,
         procedure(const P: TuPacket) begin ServerUPDHandler(P); end,
         procedure(const P: TuPacket) begin HubUPDHandler(P);  end
      ]
   );

   Dispatcher.Register(pfKIL,
      [npUDP, npTCP],
      [nrNone, nrClient, nrServer, nrHub],
      [
         procedure(const P: TuPacket) begin NoneKILHandler(P); end,
         procedure(const P: TuPacket) begin ClientKILHandler(P); end,
         procedure(const P: TuPacket) begin ServerKILHandler(P); end,
         procedure(const P: TuPacket) begin HubKILHandler(P);  end
      ]
   );

   Dispatcher.Register(pfSHFT,
      [npUDP, npTCP],
      [nrClient, nrServer, nrHub],
      [
         procedure(const P: TuPacket) begin ClientSHFTHandler(P); end,
         procedure(const P: TuPacket) begin ServerSHFTHandler(P); end,
         procedure(const P: TuPacket) begin HubSHFTHandler(P);  end
      ]
   );

end;


///////////////////////////////////////////////////////////////////////////////
//// Handler Implementations::
///////////////////////////////////////////////////////////////////////////////

end.



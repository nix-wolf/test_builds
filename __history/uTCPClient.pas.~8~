unit uTCPClient;

interface

uses
  System.Net.Socket,
  System.SysUtils,
  System.Classes,
  System.Threading,
  uReadThread;

type
  TOnDataReceived = procedure(const aData: String) of Object;

  TuTCPClient = class
    private
      FSocket: TSocket;
      //todo: Read Thread should be own unit, implmented twice
      FReadThread: TuReadThread;
      FOnData: TOnDataReceived;
      FConnected: Boolean;
    public
      constructor Create;
      destructor Destroy; override;
      procedure Connect(const aIP: String; aPort: Integer);
      procedure Disconnect;
      procedure Send(const aMsg: String);

      property OnDataReceived: TOnDataReceived read FOnData write FOnData;
      property Connected: Boolean read FConnected;
  end;

implementation

{ TuTCPClient }

///////////////////////////////////////////////////////////////////////////////
//// Construction/Initalization
///////////////////////////////////////////////////////////////////////////////

constructor TuTCPClient.Create;
begin
  inherited;
  FConnected := False;
end;

procedure TuTCPClient.Connect(const aIP: String; aPort: Integer);
begin
  FSocket := TSocket.Create(TSocketType.TCP);
  FSocket.Connect('', aIP, '', aPort);
  FConnected := True;

  //todo probably create a seperate handling than a regular disconnect?
  FReadThread := TuReadThread.Create(FSocket, OnDataReceived, Disconnect);
  FReadThread.Start;
end;

///////////////////////////////////////////////////////////////////////////////
//// Other
///////////////////////////////////////////////////////////////////////////////

procedure TuTCPClient.Send(const aMsg: String);
var
   aBuffer: TBytes;
begin
  if not FConnected then Exit;
  aBuffer := TEncoding.UTF8.GetBytes(aMsg + #10);
  FSocket.Send(aBuffer, 0, Length(aBuffer));
end;

///////////////////////////////////////////////////////////////////////////////
//// Deconstruction
///////////////////////////////////////////////////////////////////////////////

procedure TuTCPClient.Disconnect;
begin
  FConnected := False;
  if Assigned(FSocket) then FSocket.Close;
end;

destructor TuTCPClient.Destroy;
begin
  Disconnect;
  inherited;
end;

end.

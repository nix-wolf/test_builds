unit uTCPServer;

interface

uses
  System.Net.Socket,
  System.SysUtils,
  System.Classes,
  System.Generics.Collections,
  uTCPClient;

type
  TOnClientMessage = procedure(aClient: TuTCPClient; const aMsg: String) of Object;

  TClientEvent = procedure(aClient: TuTCPClient) of Object;

  TuTCPServer = class
    private
      FListener: TSocket;
      FClients: TList<TSocket>;
      FActive: Boolean;
      FOnMsg: TOnClientMessage;
      FOnConnect: TClientEvent;
      FOnDisconnect: TClientEvent;

      procedure Listen;
      procedure ReadClientMessages(aClient: TSocket);
    public
      constructor Create;
      destructor Destroy; override;

      procedure Start(aPort: Integer);
      procedure Stop;
      procedure Broadcast(const aMsg: String);
      property OnMessage: TOnClientMessage read FOnMsg write FOnMsg;
      property OnConnected: TClientEvent read FOnConnect write FOnConnect;
      property OnDisconnected: TClientEvent
        read FOnDisconnect write FOnDisconnect;

  end;
implementation

{ TuTCPServer }

///////////////////////////////////////////////////////////////////////////////
//// Construction/Initalization
///////////////////////////////////////////////////////////////////////////////

constructor TuTCPServer.Create;
begin
  FClients := TList<TSocket>.Create;
  FActive := False;
end;

procedure TuTCPServer.Start(aPort: Integer);
begin
  FListener := TSocket.Create(TSocketType.TCP);
  FListener.Bind(aPort);
//  FListener.L;
  FActive := True;

  TThread.CreateAnonymousThread(Listen).Start;
end;

///////////////////////////////////////////////////////////////////////////////
//// Other
///////////////////////////////////////////////////////////////////////////////

procedure TuTCPServer.Listen;
begin
  while FActive do begin
    var aClient := FListener.Accept(500);
    if Assigned(aClient) then begin
      TMonitor.Enter(FClients);
      try
        FClients.Add(aClient);
      finally
        TMonitor.Exit(FClients);
      end;
      TThread.CreateAnonymousThread(procedure begin
        ReadClientMessages(aClient);
      end).Start; {PROCEDURE}
    end; {IF}
  end; {WHILE}
end;

procedure TuTCPServer.Broadcast(const aMsg: String);
var
  aBuffer: TBytes;
  aClient: TSocket;
begin
  aBuffer := TEncoding.UTF8.GetBytes(aMsg + #10);
  TMonitor.Enter(FClients);
  try
    for aClient in FClients do begin
      if TSocketState.Connected in aClient.State then
        aClient.Send(aBuffer, 0, Length(aBuffer));
    end;
  finally
    TMonitor.Exit(FClients);
  end;
end;

procedure TuTCPServer.ReadClientMessages(aClient: TSocket);
var
  aBuffer: TBytes;
  aLen: Integer;
  aFinalMsg: String;
begin
  SetLength(aBuffer, 4096);
  aFinalMsg := '';
  //todo: This is both in server and client should be shifted to a helper function
  while FActive and (TSocketState.Connected in aClient.State) do begin
    if aClient.ReceiveLength > 0 then begin
      aLen := aClient.Receive(aBuffer, 0, Length(aBuffer));
      if aLen <= 0 then Break;

      aFinalMsg := aFinalMsg + TEncoding.UTF8.GetString(aBuffer, 0 , aLen);
      while Pos(#10, aFinalMsg) > 0 do begin
        var i := Pos(#10, aFinalMsg);
        var aLine := Copy(aFinalMsg, 1, i - 1).Trim;
        aFinalMsg := Copy(aFinalMsg, i + 1, MaxInt);

        if Assigned(FOnMsg) then
          TThread.Queue(nil, procedure begin
            FOnMsg(aClient.Endpoint.Address.Address, aLine);
          end);
      end; {WHILE}
    end; {IF}
  end; {WHILE}
  TMonitor.Enter(FClients);
  FClients.Remove(aClient);
  TMonitor.Exit(FClients);
end;

///////////////////////////////////////////////////////////////////////////////
//// Deconstruction
///////////////////////////////////////////////////////////////////////////////

procedure TuTCPServer.Stop;
begin
  FActive := False;
  FListener.Close;
end;

destructor TuTCPServer.Destroy;
begin
  Stop;
  FClients.Free;
end;

end.

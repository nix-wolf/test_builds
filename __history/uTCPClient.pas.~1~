unit uTCPClient;

interface

uses
  System.Net.Socket,
  System.SysUtils,
  System.Classes,
  System.Threading;

type
  TOnDataReceived = procedure(const aData: String) of Object;

  TuTCPClient = class(TObject)
    private
      FSocket: TSocket;
      FReadThread: TThread;
      FOnData: TOnDataReceived;
      FConnected: Boolean;
      procedure ExecuteRead;
    public
      constructor Create;
      destructor Destroy; override;
      procedure Connect(const aIP: String; aPort: Integer);
      procedure Disconnect;
      procedure Send(const aMsg: String);

      property OnDataReceived: TOnDataReceived read FOnData write FOnData;
      property Connected: Boolean read FConnected;
  end;

implementation

{ TuTCPClient }

constructor TuTCPClient.Create;
begin
  inherited;
  FConnected := False;
end;

destructor TuTCPClient.Destroy;
begin
  Disconnect;
  inherited;
end;


procedure TuTCPClient.Connect(const aIP: String; aPort: Integer);
begin
  FSocket := TSocket.Create(TSocketType.TCP);
  FSocket.Connect('', aIP, '', aPort);
  FConnected := True;

  FReadThread := TThread.CreateAnonymousThread(ExecuteRead);
  FReadThread.FreeOnTerminate := True;
  FReadThread.Start;
end;

procedure TuTCPClient.Disconnect;
begin
  FConnected := False;
  if Assigned(FSocket) then FSocket.Close;
end;

procedure TuTCPClient.Send(const aMsg: String);
var
   aMsgBytes: TBytes;
begin
  if not FConnected then Exit;
  aMsgBytes := TEncoding.UTF8.GetBytes(aMsg + #10);
  FSocket.Send(aMsgBytes, 0, Length(aMsgBytes));
end;

procedure TuTCPClient.ExecuteRead;
var
  aBuffer: TBytes;
  aLen: Integer;
  aString, Accumulator: String;
  i: Integer;
begin
  SetLength(aBuffer, 4096);
  Accumulator := '';

  while FConnected do begin


  end;{WHILE}
end;

end.

unit uTCPServer;

interface

uses
  System.Net.Socket,
  System.SysUtils,
  System.Classes,
  System.Generics.Collections;

type
  TOnClientMessage = procedure(const aClientIP: String; const aMsg: String) of Object;

  TuTCPServer = class(TObject)
    private
      FListener: TSocket;
      FClients: TList<TSocket>;
      FActive: Boolean;
      FOnMsg: TOnClientMessage;

      procedure Listen;
      procedure ReadClientMessages(aClient: TSocket);
    public
      constuctor Create;
      dectructor Destroy; override;

      procedure Start(aPort: Interger);
      procedure Stop;
      procedure Broadcast(const aMsg: String);
      property OnMessage: TOnClientMessage read FOnMsg write FOnMsg;
  end;
implementation

{ TuTCPServer }

constructor TuTCPServer.Create;
begin
  inherited;
  FClients := TList<TSocket>.Create;
  FActive := False;
end;

procedure TuTCPServer.Listen;
begin
  while FActive do begin
    var aClient := FListener.Accept(500);
    if aClient <> nil then begin
      TMonitor.Enter(FClients)
      try
        FClients.Add(aClient);
      finally
        TMonitor.Exit(FClients);
      end;
      TThread.TThread.CreateAnonymousThread(procedure being ReadClientMessages(aClient); end).Start;
    end; {IF}
  end; {WHILE}
end;

procedure TuTCPServer.Broadcast(const aMsg: String);
var
  aBuffer: TBytes;
  aClient: TSocket;
begin
  aBuffer := TEncoding.UTF8.GetBytes(aMsg + #10);
  TMonitor.Enter(FClients);
  try
    for aClient in FClients do
      if Client.State = TSoocketState.Conneted then
        Client.Send(aBuffer, 0, Length(aBuffer));
  finally
    TMoniter.Exit(FClients);
  end;
end;

procedure TuTCPServer.ReadClientMessages(aClient: TSocket);
  aBuffer: TBytes;
  aLen: Integer;
  aFinalMsg: String;
begin
  SetLength(aBuffer, 4096);
  aFinalMsg := '';
  //todo: This is both in server and client should be shifted to a helper function
  while FActive and (aClient.State = TSocketState.Connected) do begin
    if aClient.SelectForRead(100) then begin
      aLen := aClient.Receive(aBuffer, 0, Length(aBuffer));
      if aLen <= 0 then Break;

      aFinalMsg := aFinalMsg + TEncoding.UTF8.GetString(aBuffer, 0 , aLen);
      while Pos(#10, aFinalMsg) > 0 do begin
        var i := Pos(#10, aFinalMsg);
        var aLine := Copy(aFinalMsg, 1, i - 1).Trim;
        aFinalMsg := Copy(aFinalMsg, i + 1, MaxInt);
      end; {WHILE}
    end; {IF}
  end; {WHILE}

end;

procedure TuTCPServer.Stop;
begin
  FActive := False;
  FListener.Close;
end;

destructor TuTCPServer.Destroy;
begin
  Stop;
  FClients.Free;
end;

end.
